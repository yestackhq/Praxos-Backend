# Praxos LMS backend — copy to backend/.env

# ---- Database ---------------------------------------------------------------
# Default (unset) uses local SQLite so the app runs with no services.
# For Supabase Postgres, install psycopg ("pip install 'psycopg[binary]'") and set:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<host>:5432/postgres
# DB_SCHEMA=praxos_lms

CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# ---- Clerk auth -------------------------------------------------------------
# Leave unset for review/dev mode (endpoints open). When set, all /api routes
# require a valid Clerk session JWT.
# CLERK_JWKS_URL=https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<your-subdomain>.clerk.accounts.dev
# CLERK_SECRET_KEY=sk_test_...

# ---- AI provider ------------------------------------------------------------
# The provider is a deployment choice, not a code constant (lms_app/llm.py).
# `openai_compatible` covers anything speaking /v1/chat/completions — Groq,
# Together, Fireworks, OpenRouter, vLLM, LiteLLM, an in-house gateway: just point
# LLM_BASE_URL at it and set LLM_MODEL.
LLM_PROVIDER=openai              # openai | openai_compatible | poke | none
LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...             # falls back to OPENAI_API_KEY
LLM_MODEL=gpt-4o

# Embeddings may come from a different provider.
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536

# NOTE on LLM_PROVIDER=poke: Poke's API (POST /api/v1/inbound/api-message) only
# ACCEPTS a message and replies {"success": true}. It returns no completion, has
# no model parameter and does not stream, so it cannot do inference and cannot
# sit between speech-to-text and text-to-speech. Selecting it raises a clear
# error. Poke is wired up as a NOTIFIER instead — see POKE_API_KEY below.

# ---- Voice: LiveKit + Deepgram (STT) + Cartesia (TTS) ------------------------
# The browser joins a LiveKit room; the agent worker (voice_agent/agent.py) runs
# Deepgram -> LLM -> Cartesia and publishes the tutor's audio back.
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=multi
# CARTESIA_API_KEY=
# CARTESIA_MODEL=sonic-2
# CARTESIA_VOICE=a0e99841-438c-4a64-b679-ae501e7d6091

# Shared secret the agent worker presents on /api/sessions/agent/*. Generate one
# per environment (e.g. `openssl rand -hex 32`) and give the same value to the
# worker. Unset => those routes are closed.
# AGENT_SHARED_SECRET=

# ---- Memory: mem0 -----------------------------------------------------------
# The tutor writes each sitting here and reads back a recap, so it remembers the
# learner across sections. Unset => the tutor teaches without recall.
# MEM0_API_KEY=m0-...
# MEMORY_RECAP_FACTS=6

# ---- Poke (notifications only) ----------------------------------------------
# Pushes "learner is at risk" / "learner finished a document" into the admin's
# Poke assistant. Opt-in.
# POKE_API_KEY=
# POKE_NOTIFY_AT_RISK=false

# ---- Scoring ----------------------------------------------------------------
# AT_RISK_THRESHOLD=55     # below this a learner shows as needing attention
# MASTERY_THRESHOLD=70     # a section must reach this to count as understood

# ---- Original-PDF storage ---------------------------------------------------
# Client-side: the browser uploads to Supabase Storage with the publishable key.
# Configure it in web/.env (VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY,
# VITE_SUPABASE_BUCKET). The backend never needs a Supabase service key.
